# ── Machines ──────────────────────────────────────────────────────────────────
# Format: IP:PORT:MACHINE_ID (comma-separated)
WATCH_MACHINES=192.168.1.101:4370:1,192.168.1.102:4370:2

# ── Connection ────────────────────────────────────────────────────────────────
CONNECT_TIMEOUT_SECONDS=5

# ── Attendance Poller ─────────────────────────────────────────────────────────
# How many days back to pull logs (safety buffer for missed data)
POLL_LOOKBACK_DAYS=7

# Time to run the daily poll (24h HH:MM)
POLL_TIME=01:00

# SQL Server connection string
# Example (SQL auth):
#   DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=192.168.1.10;DATABASE=att2000;UID=sa;PWD=yourpassword
# Example (Windows auth):
#   DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=192.168.1.10;DATABASE=att2000;Trusted_Connection=yes
DB_CONNECTION_STRING=
