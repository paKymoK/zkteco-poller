# ── Machines ──────────────────────────────────────────────────────────────────
# Format: IP:PORT:MACHINE_ID (comma-separated)
WATCH_MACHINES=192.168.1.101:4370:1,192.168.1.102:4370:2

# ── Connection ────────────────────────────────────────────────────────────────
CONNECT_TIMEOUT_SECONDS=5
MAX_WORKERS=10

# ── Attendance Poller ─────────────────────────────────────────────────────────
# How many days back to pull logs (safety buffer for missed data)
POLL_LOOKBACK_DAYS=7

# Time to run the daily poll (24h HH:MM)
POLL_TIME=01:00

# SQL Server connection string
DB_SERVER=ip_address
DB_PORT=1433
DB_NAME=Att2000
DB_USER=
DB_PASSWORD=
